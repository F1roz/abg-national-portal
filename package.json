{
  "name": "abg-portal",
  "version": "0.1.0",
  "private": true,
  "description": "AIESEC in Bangladesh National Portal - a configurable organisational operating system",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push --force",
    "db:generate": "drizzle-kit generate",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/reset.ts && drizzle-kit push --force && tsx src/db/seed.ts",
    "jobs": "tsx src/jobs/cli.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "node tests/e2e-recruitment.mjs && node tests/e2e-work.mjs",
    "test:smoke": "node tests/smoke.mjs"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "drizzle-orm": "0.45.4",
    "next": "15.5.27",
    "nodemailer": "^6.10.1",
    "postgres": "3.4.9",
    "qrcode": "1.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.1.11",
    "@types/node": "22.15.30",
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.7",
    "drizzle-kit": "0.31.11",
    "playwright": "^1.56.1",
    "tailwindcss": "4.1.11",
    "tsx": "4.20.3",
    "typescript": "5.8.3"
  }
}
