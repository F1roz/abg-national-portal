# PostgreSQL connection
DATABASE_URL=postgres://abg:abg@localhost:5432/abg_portal
# Public URL of the portal (used in emails and secure links)
APP_URL=http://localhost:3000
# Secret for the automation endpoint (/api/cron). Use a long random value.
CRON_SECRET=change-me
# Where uploaded files are stored (local disk). Swap src/lib/storage.ts for S3/R2 in production.
STORAGE_DIR=./storage
# Optional SMTP. When unset, emails are written to the outbox (Admin → Email outbox) only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="AIESEC in Bangladesh <no-reply@example.org>"
